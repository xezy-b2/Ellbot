# ===== Discord (bot) =====
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ===== Base de données =====
# Mets ici ton URL MongoDB Atlas (avec le NOUVEAU mot de passe)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/discord-bot?retryWrites=true&w=majority

# ===== Dashboard web =====
# Une longue chaîne aléatoire (ex : générée avec `openssl rand -hex 32`)
SESSION_SECRET=
BASE_URL=http://localhost:3000
# Optionnel : par défaut BASE_URL + /auth/discord/callback (doit être déclarée dans le Developer Portal)
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ===== Twitch =====
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ===== Hébergement (Railway) =====
# Dossier où sont stockées les images envoyées et le cache Twitch.
# Sur Railway : DATA_DIR=/data avec un Volume monté sur /data
# DATA_DIR=/data
# Railway fournit PORT automatiquement ; en local c'est 3000 par défaut
# PORT=3000

# ===== Alertes =====
# URL d'un webhook Discord (Paramètres du salon → Intégrations → Webhooks).
# Le bot y signale ses erreurs et ses démarrages. Laisser vide pour désactiver.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ===== Options =====
# BOT_PREFIX=!
# Utilisateurs (IDs séparés par des virgules) autorisés à faire !shutdown / !restart en plus du propriétaire du bot
# BOT_ADMIN_IDS=706520558581579827
# Nom du process PM2 pour !restart
# PM2_PROCESS_NAME=index
# Salon où seul 💩 est autorisé (mettre une valeur vide pour désactiver)
# POOP_CHANNEL_ID=1451295114814034103
